# Free guide signups (first name, email, phone) are saved to the guide_leads
# table in The Intimacy Masters' Supabase project. Both values are required on
# the live site: without them the guide stays locked, so no signup is lost.
#
# Find them in Supabase under Project Settings, API. The publishable key is
# safe to use here: it can only add rows to guide_leads, never read them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
